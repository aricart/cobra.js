{
  "compilerOptions": {
    "strict": true
  },
  "nodeModulesDir": "none",
  "name": "@aricart/cobra",
  "version": "0.2.1-0",
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "test": {
    "exclude": [
      "tests/node_test.mjs",
      "tests/node_test.cjs"
    ]
  },
  "exclude": [
    "lib/",
    "coverage/",
    "cov/"
  ]
}
